{
    "name": "homepage",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "deno lint",
        "format": "deno fmt",
        "wrangler": "vite build && wrangler pages dev .svelte-kit/cloudflare"
    },
    "devDependencies": {
        "@sveltejs/adapter-cloudflare": "^5.0.0",
        "@sveltejs/kit": "^2.0.0",
        "@sveltejs/vite-plugin-svelte": "^5.0.0",
        "@types/markdown-it": "^14.0.0",
        "@types/sanitize-html": "^2.11.0",
        "svelte": "^5.0.0",
        "svelte-check": "^4.0.0",
        "tslib": "^2.6.0",
        "typescript": "^5.5.0",
        "vite": "^6.0.0",
        "wrangler": "^4.0.0"
    },
    "type": "module",
    "dependencies": {
        "markdown-it": "^14.0.0",
        "memfs-browser": "^3.4.13000",
        "ordinal": "^1.0.3",
        "sanitize-html": "^2.13.0"
    }
}
